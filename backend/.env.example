# PostgreSQL (SQL) connection - replace placeholders with your values
# NOTE: Do NOT commit real credentials. Use secure secret storage in CI/CD.
DB_HOST=YOUR_DB_HOST
DB_PORT=5432
DB_NAME=fluentwork_db
DB_USER=postgres
DB_PASS=YOUR_DB_PASSWORD

# NoSQL (chat history) - replace with your NoSQL connection string
MONGO_URI=mongodb://localhost:27017/fluentwork-chat
# For backward compatibility, NOSQL_URL is also accepted.
NOSQL_URL=mongodb://localhost:27017/fluentwork-chat

# App
PORT=3000
 
# JWT
JWT_SECRET=your_jwt_secret_here
